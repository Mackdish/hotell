# Supabase project URL and publishable/anon key (safe for browser use with RLS enabled).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# PayzaAPI credentials (server-side only; never use NEXT_PUBLIC_ prefix).
PAYZA_PUBLIC_KEY=pk_test_replace_me
PAYZA_SECRET_KEY=sk_test_replace_me
PAYZA_WEBHOOK_SECRET=replace_with_payza_webhook_signing_secret

# Supabase service role key (server-side only; never expose to the browser).
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Public HTTPS origin of the deployed app, without a trailing slash.
APP_BASE_URL=https://your-app-domain.example
